<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rosbag_recorder_bridge</name>
  <version>0.1.0</version>
  <description>Headless ROS 2 control surface for ros2_bag_recorder: start and
  stop recordings over services, publish recorder status and live topic
  statistics. Runs on the robot; needs no GUI.</description>
  <maintainer email="c.k.rajendra@saxion.nl">wall-e</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>ros2_bag_recorder</depend>
  <depend>rosbag_recorder_msgs</depend>
  <depend>builtin_interfaces</depend>

  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-psutil</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
