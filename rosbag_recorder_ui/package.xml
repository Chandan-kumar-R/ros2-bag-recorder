<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rosbag_recorder_ui</name>
  <version>0.1.0</version>
  <description>Desktop dashboard for the ROS 2 bag recorder: configure, start,
  monitor and stop rosbag2 recordings without touching a terminal. Talks to
  rosbag_recorder_bridge over ROS 2 services and topics.</description>
  <maintainer email="c.k.rajendra@saxion.nl"></maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>rosbag_recorder_msgs</depend>
  <depend>rcl_interfaces</depend>

  <exec_depend>rosbag_recorder_bridge</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>python3-pip</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
